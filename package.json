{
  "name": "comer-fora-no-salao",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "depcruise src app --config .dependency-cruiser.cjs",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test --trace off",
    "db:generate": "drizzle-kit generate",
    "build:turbo": "next build && node scripts/prepare-standalone.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@langfuse/otel": "6.1.1",
    "@langfuse/tracing": "6.1.1",
    "@langfuse/vercel-ai-sdk": "6.1.1",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.1",
    "@opentelemetry/sdk-node": "0.223.2",
    "@opentelemetry/sdk-trace-base": "2.12.1",
    "@tailwindcss/postcss": "4.3.5",
    "ai": "7.0.177",
    "aws4fetch": "1.0.20",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "pdfjs-dist": "6.5.438",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "18.8.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "tesseract.js": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
